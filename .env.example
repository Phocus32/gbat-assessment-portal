# Copy to .env for local development. Nothing here is needed on Vercel except
# the Firebase credentials and JWT_SECRET, which are set in the Vercel dashboard.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Optional data directory for locally-generated files (e.g. the development
# JWT secret). Defaults to ./data.
# DATA_DIR=./data

# --- Firebase (required in production) --------------------------------------
# Easiest production setup: put the whole downloaded service-account JSON on
# one line in FIREBASE_SERVICE_ACCOUNT.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Or provide the three values separately. Keep the private key on one line with
# literal \n characters, or paste the real multi-line value into Vercel.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n

# Instead of real Firebase, you can run `npm run emulators` locally and use:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_PROJECT_ID=gbat-test

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# A development secret is generated into ./data automatically if omitted.
# JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=4h

# Set to false to start with only an admin account (no classes/quizzes/demo students).
SEED_DEMO=true

# Optional first-run admin. If ADMIN_PASSWORD is omitted, a random password is
# generated and printed once in the startup log.
# ADMIN_NAME=Portal Administrator
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-long-password

# Optional first-run teacher used to own the imported question bank.
# IMPORT_TEACHER_NAME=Learners Connect Teacher
# IMPORT_TEACHER_USERNAME=gbat.teacher

# Set to true when serving over HTTPS (also enabled automatically in production).
COOKIE_SECURE=false

# Set to true behind a reverse proxy (also enabled automatically in production).
TRUST_PROXY=false

BCRYPT_ROUNDS=12
API_RATE_MAX=5000
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_MAX=100
EXAM_GRACE_SECONDS=20

# Optional AI Guide. The key is used only on the server; never expose it to the
# browser. GEMINI_API_KEY is accepted as a fallback for GOOGLE_API_KEY.
# GOOGLE_API_KEY=replace-with-a-google-ai-studio-key
# GEMINI_MODEL=gemini-3.8-flash
# AI_MAX_OUTPUT_TOKENS=600

# Inactivity logout (minutes before an idle user is signed out, and how long
# the warning is shown beforehand). Defaults: 1 minute, 15 second warning.
IDLE_TIMEOUT_MINUTES=1
IDLE_WARNING_SECONDS=15
IDLE_HEARTBEAT_SECONDS=15
ACTIVITY_WRITE_INTERVAL_SECONDS=15
