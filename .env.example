# Copy to .env for local development. Every value is optional: with no
# config the app creates ./data/gbat.db and seeds a demo portal on first run.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000

# Storage: sqlite (default) or mysql
DB_DRIVER=sqlite
DATA_DIR=./data
SQLITE_PATH=./data/gbat.db

# Set to false to start with only an admin account (no classes/quizzes/demo students).
SEED_DEMO=true

# Optional first-run admin. If ADMIN_PASSWORD is omitted, a random password is
# generated and printed once in the startup log + data/initial-credentials.txt.
# ADMIN_NAME=Portal Administrator
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=replace-with-a-long-password

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If omitted, a persistent secret is generated inside DATA_DIR automatically.
# JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=4h

# Set to true when serving over HTTPS (also enabled automatically in production).
COOKIE_SECURE=false

# Set to true behind a reverse proxy (also enabled automatically in production).
TRUST_PROXY=false

BCRYPT_ROUNDS=12
API_RATE_MAX=5000
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_MAX=100
EXAM_GRACE_SECONDS=20

# --- Optional MySQL mode -----------------------------------------------------
# DB_DRIVER=mysql
# Either DATABASE_URL=mysql://user:password@host:3306/gbat_portal
# or the individual values below:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=gbat_app
# DB_PASSWORD=replace-with-a-strong-password
# DB_NAME=gbat_portal
# DB_CONNECTION_LIMIT=10
# DB_SSL=true                 # required by many hosted MySQL providers
# DB_SSL_REJECT_UNAUTHORIZED=false
